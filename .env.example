# Placeholders only. Put real values in Vercel > Settings > Environment Variables.
TELEGRAM_TOKEN=replace_with_botfather_token
GEMINI_API_KEY=replace_with_google_ai_studio_key
# Only letters, digits, _ and - (1-256 chars). Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
GEMINI_MODEL=gemini-3.8-flash

# OPTIONAL - post "time, user, question" to your Telegram channel.
# Use @channelusername (public channel) or the numeric id like -1001234567890.
# The bot must be an ADMIN of the channel with permission to post messages.
# LOG_CHANNEL_ID=@your_channel_username

# OPTIONAL - conversation memory + duplicate-update protection (Upstash Redis REST).
# Leave unset to run without memory. Vercel Marketplace may name them KV_REST_API_URL / KV_REST_API_TOKEN (also supported).
# UPSTASH_REDIS_REST_URL=replace_with_upstash_rest_url
# UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token
